{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MQL5: Compile",
            "type": "shell",
            "command": "\"/Applications/MetaTrader 5.app/Contents/Resources/drive_c/Program Files/MetaTrader 5/metaeditor64.exe\"",
            "args": [
                "/compile:\"${file}\"",
                "/log",
                "/inc:\"${fileDirname}\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": {
                "owner": "mql5",
                "fileLocation": [
                    "relative",
                    "${fileDirname}"
                ],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+),(\\d+)\\)\\s+:\\s+(warning|error)\\s+\\d+:\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}